{
  "manifest_version": 3,
  "name": "Отклик",
  "version": "0.1.0",
  "description": "На странице вакансии: match, письмо в буфер, запись в трекер. Отправку подтверждаешь ты.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Отклик",
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "https://hh.ru/*",
    "https://*.hh.ru/*",
    "https://career.habr.com/*",
    "https://otklik-gamma.vercel.app/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hh.ru/vacancy/*",
        "https://*.hh.ru/vacancy/*",
        "https://career.habr.com/vacancies/*"
      ],
      "js": ["lib/core.js", "content/vacancy.js"],
      "css": ["content/vacancy.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://otklik-gamma.vercel.app/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*"
      ],
      "js": ["lib/core.js", "content/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
